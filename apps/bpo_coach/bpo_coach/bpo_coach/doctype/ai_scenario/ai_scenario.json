      "reqd": 1
    },
    {
      "fieldname": "draft_revision",
      "label": "Draft Revision",
      "fieldtype": "Int",
      "default": "1"
    },
    {
      "fieldname": "published_version",
      "label": "Published Version",
      "fieldtype": "Link",
      "options": "AI Scenario Version"
    }
  ],
  "permissions": [
    {
      "role": "BPO Administrator",
      "read": 1,
      "report": 1,
      "export": 1,
      "print": 1
    }
